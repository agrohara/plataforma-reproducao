  }

  normId(id) { return String(id).toUpperCase().replace(/[^0-9]/g, '').replace(/^0+/, ''); }
  similar(lote, id) {
    const n = this.normId(id);
    if (!n) return '';
    const u = String(id).toUpperCase();
    const pool = lote.animals.map(a => a.id).concat((this.state.fazReg[lote.faz] || []).map(a => a.id));
    return pool.find(x => x.toUpperCase() !== u && this.normId(x) === n) || '';
  }
  confAlerts(lote) {
    if (lote.rows) {
      const al = [];
      this.rowInfo(lote, lote.rows).forEach(o => {
        if (!o.id) return;
        const ln = 'Linha ' + (o.i + 1) + ': ';
        if (o.kind === 'dup') { al.push({ key: 'r' + o.i + ':dup', id: o.id, row: o.i, block: true, msg: ln + 'brinco repetido (já está na linha ' + (o.dupOf + 1) + ').' }); return; }
        if (o.kind === 'outro') { al.push({ key: 'r' + o.i + ':outro', id: o.id, row: o.i, block: true, msg: ln + 'está no ' + o.other + ', ativo. Um animal não participa de dois lotes ativos.' }); return; }
        if (o.ccBad) al.push({ key: o.id + ':ccbad', id: o.id, row: o.i, block: true, msg: ln + 'CC inválida (' + lote.rows[o.i].cc + '). Use 1 a 5, de 0,5 em 0,5.' });
        if (o.sim) al.push({ key: o.id + ':sim', id: o.id, row: o.i, block: false, msg: ln + 'parecido com ' + o.sim + ', que já existe. Confira se não é o mesmo animal.' });
        if (!o.cc && !o.ccBad) al.push({ key: o.id + ':cc', id: o.id, row: o.i, block: false, msg: ln + 'sem condição corporal registrada.' });
      });
      return al;
    }
    const out = [];
    lote.animals.forEach(a => {
      const sim = this.similar(lote, a.id);
      if (sim) out.push({ key: a.id + ':sim', id: a.id, msg: 'Parecido com ' + sim + ', que já existe. Confira se não é o mesmo animal.' });
      if (!a.cc) out.push({ key: a.id + ':cc', id: a.id, msg: 'Sem condição corporal registrada.' });
    });
    return out;
  }

  formSave() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const lote = s.lotes[sess.loteId];
    const id = String(s.fq || '').trim().toUpperCase();
    if (!id) { this.flash('Digite o brinco do animal.', false); return; }
    const dup = lote.animals.find(a => a.id.toUpperCase() === id);
    if (dup) { this.flash('O brinco ' + id + ' já foi registrado nesta formação (posição ' + dup.seq + ').', false); return; }
    const other = this.inOtherLot(lote, id);
    if (other) { this.flash(id + ' está no ' + other.nome + ', ativo. Um animal não participa de dois lotes ativos.', false); return; }
    const reg = (s.fazReg[lote.faz] || []).find(a => a.id.toUpperCase() === id);
    const cat = s.fcat || lote.catSug;
    const obs = [].concat(s.fobs, String(s.fobsTxt || '').trim() ? [String(s.fobsTxt).trim()] : []).join(' · ');
    const animal = { id: id, cat: cat, cc: s.fcc || '', obs: obs, novo: !reg, catOrig: cat === lote.catSug ? 'sugestão confirmada' : 'escolhida', seq: lote.animals.length + 1, t: this.fmt(s.now.min) };
    const lotes = Object.assign({}, s.lotes);
    lotes[lote.id] = Object.assign({}, lote, { animals: lote.animals.concat([animal]) });
    this.setState({ lotes: lotes, now: this.adv(0.4), fq: '', fcat: lote.catSug, fcc: '', fobs: [], fobsTxt: '', undo: this.snap() });
    this.flash(id + ': registrado nesta formação (simulação, nada é gravado).', true);
  }

  removeAnimal(id) {
    const s = this.state;
    const sess = this.sess(s.sid);
    const lote = s.lotes[sess.loteId];
    const animals = lote.animals.filter(a => a.id !== id).map((a, i) => Object.assign({}, a, { seq: i + 1 }));
