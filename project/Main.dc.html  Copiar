    this.setState({ lotes: lotes, undo: this.snap() });
    this.flash(id + ' retirado da formação.', true);
  }

  concluir() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const lote = s.lotes[sess.loteId];
    if (!lote.animals.length) { this.flash('Nenhum animal registrado.', false); return; }
    const blk = this.confAlerts(lote).filter(a => a.block);
    if (blk.length) { this.flash('Corrija ' + (blk.length === 1 ? 'a linha bloqueada' : 'as ' + blk.length + ' linhas bloqueadas') + ' antes de concluir.', false); return; }
    const pend = this.confAlerts(lote).filter(a => !a.block && !s.ack[a.key]);
    if (pend.length) { this.flash('Resolva ou mantenha ' + (pend.length === 1 ? 'o alerta' : 'os ' + pend.length + ' alertas') + ' antes de concluir.', false); return; }
