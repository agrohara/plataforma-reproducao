      const w = s.wiz;
      if (w.kind === 'faz') {
        this.setState({ sheet: null, wiz: Object.assign({}, w, {
          cli: { nome: 'Produtor Fictício', doc: 'CPF fictício 000.000.000-01', contato: '(00) 00000-0001', email: 'produtor@exemplo.ficticio' },
          ger: { nome: 'Gerente Fictício', tel: '(00) 00000-0002' },
          faz: { nome: 'Fazenda Exemplo A', mun: 'Londrina', uf: 'PR', lat: '-23,4210', lon: '-51,0350', ie: '', ativ: 'Pecuária de corte', fase: 'Cria', sist: 'Extensivo (a pasto)', reb: { matrizes: '180', primiparas: '40', novilhas: '60', bezM: '85', bezF: '80', garrotes: '30', touros: '6', equinos: '8' } },
          munQ: '',
          team: [], mem: { nome: '', func: '' }
        }) });
        this.flash('Simulação: campos preenchidos com os dados do roteiro. Avance com “Continuar”.', false);
      } else {
        const f = this.state.fazendas[w.fid];
        this.setState({ sheet: null, wiz: Object.assign({}, w, { nome: w.origem ? w.nome : 'LOTE 07', nomeEd: !w.origem, prevTxt: w.origem ? w.prevTxt : '60', tipo: w.origem ? w.tipo : 'parida', cat: w.origem ? w.cat : 'Multípara', curral: w.curral || 'Curral do Cocheirão', proto: 'IATF3', dRet: 8, hIa: 48, vet: 'Resp. Fictício', ins: '', estacao: w.estacao || '26/27',
          touros: (w.touros || []).some(t => t.nome) ? w.touros : [{ nome: 'Touro Exemplo 1', raca: 'Nelore', partidas: ['1023', '1187'] }, { nome: 'Touro Exemplo 2', raca: 'Angus', partidas: ['2045'] }],
          prod: Object.assign({}, w.prod, { dispSel: (w.prod || {}).dispSel || 'Outro', disp: (w.prod || {}).disp || 'Dispositivo Exemplo' }) }) });
        this.flash('Simulação: LOTE 07, 60 fêmeas, dois touros com partidas. Avance com “Continuar”.', false);
      }
      return;
    }
    const sess = (sidO || s.sid) ? this.sess(sidO || s.sid) : null;
    if (!sess) return;
    if (s.screen === 'form' || s.screen === 'conf') {
      const lote = s.lotes[sess.loteId];
      const rows = (lote.rows || []).slice();
      const have = {};
      rows.forEach(r => { const u = String(r.vaca || '').trim().toUpperCase(); if (u) have[u] = true; });
      const reg = s.fazReg[lote.faz] || [];
      const ids = this.testIds();
      let k = 0;
      let nAdd = 0;
      for (let i = 0; i < rows.length; i++) {
        if (String(rows[i].vaca || '').trim()) continue;
        while (k < ids.length && (have[ids[k]] || this.inOtherLot(lote, ids[k]))) k += 1;
        if (k >= ids.length) break;
        const id = ids[k];
        const r = reg.find(x => x.id === id);
        const al = this.catsFor(lote);
        const c0 = r ? r.cat : this.cats()[k % 5];
        const cat = al.indexOf(c0) >= 0 ? c0 : al[0];
        rows[i] = Object.assign({}, rows[i], { vaca: id, cat: cat === lote.catSug ? '' : cat, cc: rows[i].ccAuto ? rows[i].cc : this.ccs()[k % 6], obs: '' });
        have[id] = true;
        k += 1;
        nAdd += 1;
      }
      this.putRows(lote, rows);
      this.setState({ now: this.adv(nAdd * 0.4), sheet: null });
      this.flash('Simulação: ' + nAdd + ' linhas preenchidas pelo roteiro do teste.', false);
      return;
    }
    const pend = this.participants(sess.id).filter(a => this.summ(sess.id, a.id) === 'pend');
    const one = Object.assign({}, s.recs[sess.id] || {});
    let m = s.now.min;
    const tick = () => { m += 0.5; return this.fmt(m); };
    const fic = s.ficha[sess.id] || {};
    pend.forEach((a, idx) => {
      const t = tick();
      if (sess.tipo === 'Implantação' || sess.tipo === 'Retirada') {
        const r = {};
        sess.procs.forEach(p => {
          let st = 'exec';
          let mot = '';
          if (sess.tipo === 'Retirada' && a.id === '4417') { st = 'nao'; mot = 'Animal ausente'; }
          if (sess.tipo === 'Retirada' && a.id === '1042' && p.id === 'ret') { st = 'aval'; mot = 'Dispositivo não encontrado'; }
          if (fic[a.id] && p.id === 'ret' && st === 'exec') st = 'conf';
          r[p.id] = Object.assign({ st: st, t: t, prec: 'individual', by: p.by, motivo: mot, hist: [], origem: 'simulação de teste' }, (st === 'exec' || st === 'conf') ? this.rowQ(sess.id, a.id, p) : {});
        });
        one[a.id] = r;
      } else if (sess.tipo === 'Inseminação') {
        const ri = this.retInfo(sess.loteId, a.id);
        const base = s.def[sess.id] || this.defSem();
        const ltS = s.lotes[sess.loteId];
        const alt = (s.rowBull[sess.id] || {})[a.id] !== undefined ? this.plannedSem(sess, a.id) : idx % 4 === 3 ? (ltS && ltS.touros && ltS.touros.length > 1 ? this.semFromTouro(ltS.touros[1], base.insem) : { touro: 'TOURO FICTÍCIO B', cod: 'B2', partida: 'P-0107', origem: 'Central Fictícia · lida na palheta', insem: base.insem }) : base;
        if (!ri.ok) one[a.id] = { ia: { st: 'nao', t: t, prec: 'individual', by: '', motivo: 'Retirada não confirmada', hist: [], origem: 'simulação de teste', touro: '', cod: '', partida: '', origemSem: '', insem: '' } };
        else if (a.id === 'J4') one[a.id] = { ia: { st: 'nao', t: t, prec: 'individual', by: '', motivo: 'Decisão do veterinário', hist: [], origem: 'simulação de teste', touro: '', cod: '', partida: '', origemSem: '', insem: '' } };
        else one[a.id] = { ia: { st: 'exec', t: t, prec: 'individual', by: alt.insem, motivo: '', hist: [], origem: 'simulação de teste', touro: alt.touro, cod: alt.cod, raca: alt.raca || '', partida: alt.partida, origemSem: alt.origem, insem: alt.insem } };
      } else if (sess.tipo === 'Diagnóstico') {
        const all = this.participants(sess.id);
        const pos = all.findIndex(x => x.id === a.id);
        if (pos % 28 === 27) return;
        const k = (pos * 7) % 10;
        const st = k <= 5 ? 'prenhe' : (k <= 8 ? 'vazia' : 'inconc');
        one[a.id] = { dg: { st: st, t: t, by: sess.respReal || sess.resp, obs: String(this.fichaObs(sess.id, a.id) || ''), hist: [], origem: 'simulação de teste' } };
      }
    });
    const recs = Object.assign({}, s.recs);
    recs[sess.id] = one;
    this.setState({ recs: recs, now: { day: s.now.day, min: m }, sheet: null, cur: null, q: '', override: null, undo: this.snap() });
    this.flash('Simulação: pendentes lançados pelo roteiro do teste (' + pend.length + ' animais).', true);
  }

  start() {
    const s = this.state;
    const sess = this.sess(s.sid);
    if (!sess || !sess.demo) { this.flash(sess && sess.foraMsg ? sess.foraMsg : 'Indisponível neste protótipo.', false); return; }
    const t = this.fmt(s.now.min);
    const lote = s.lotes[sess.loteId];
    this.setState({
      sessions: s.sessions.map(x => (x.id === sess.id ? Object.assign({}, x, { status: 'andamento', inicio: t, inicioDay: s.now.day }) : x)),
      screen: sess.tipo === 'Formação' ? 'form' : 'exec', cur: null, q: '', fq: '', fcat: lote.catSug, fcc: '', fobs: [], fobsTxt: ''
    });
