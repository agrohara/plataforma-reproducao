    const t = this.fmt(s.now.min);
    const d = s.now.day;
    const exists = tipo => s.sessions.some(x => x.loteId === lote.id && x.tipo === tipo);
    const pr = this.protocols().find(x => x.id === (lote.protoId || 'P01'));
    const pn = this.protoDesc(lote);
    const v3 = pr.id === 'IATF3';
    const d0 = lote.d0Day || d;
    const pref = { 'Implantação': 'i', 'Retirada': 'r', 'Inseminação': 'ia', 'Diagnóstico': 'dg' };
    const marco = v3 ? {
      'Implantação': 'D0 · implante + benzoato de estradiol · ' + pn,
      'Retirada': 'Implante (D0) em ' + this.fd(d0) + ' · retirada no D+' + this.num(lote.dRet || 8) + ' + prostaglandina, eCG e cipionato de estradiol',
      'Inseminação': 'IATF ' + this.hIaOf(lote) + ' h após a retirada planejada · GnRH na IA',
      'Diagnóstico': 'Ultrassom 30 dias após a inseminação'
    } : {
      'Implantação': 'D0 do ' + pn,
      'Retirada': 'Implante (D0) em ' + this.fd(d0) + ' · ' + pr.nome + ', versão ' + pr.versao.slice(1) + ' aprovada',
      'Inseminação': 'IATF 48 h após a retirada (' + pn + ')',
      'Diagnóstico': 'Diagnóstico após a IATF (data definida pelo veterinário)'
    };
    const add = [];
    this.etapasOf(lote).forEach(e => {
      if (!exists(e.tipo)) add.push(this.mkSess({ id: pref[e.tipo] + '-' + lote.id, loteId: lote.id, tipo: e.tipo, faz: lote.faz, team: lote.team, curralReal: sess.curralReal, procs: this.procsOf(lote, e.tipo, lote.team) || undefined, curral: sess.curralReal, planDay: d0 + e.d, planHora: e.hora, n: lote.animals.length, protocolo: pn, marco: marco[e.tipo] }));
    });
    const iaS = add.find(x => x.tipo === 'Inseminação');
    const recsOut = Object.assign({}, s.recs);
    const impI = add.findIndex(x => x.tipo === 'Implantação');
    if (v3 && impI >= 0) {
      const imp = add[impI];
      const byI = this.respName(lote, { respTipo: (lote.prod || {}).dispRespTipo, resp: (lote.prod || {}).dispResp }, (lote.team || {}).vet);
      const beC = this.prodCfg(lote.prod || {}, 'be');
      const one = {};
      lote.animals.forEach(a => {
        const row = (lote.rows || []).find(r => String(r.vaca || '').trim().toUpperCase() === a.id) || {};
        const no = row.imp === false;
        const bt = row.beTxt !== undefined && row.beTxt !== '' ? row.beTxt : beC.dose;
        one[a.id] = {
          ins: { st: no ? 'nao' : 'exec', t: t, prec: 'individual', by: byI, motivo: no ? (row.obs || 'Não implantada no D+0') : '', hist: [], origem: 'tabela do D+0', uso: (lote.prod || {}).uso || 'Novo' },
          be: { st: no ? 'nao' : 'exec', t: t, prec: 'individual', by: byI, motivo: no ? (row.obs || 'Não implantada no D+0') : '', hist: [], origem: 'tabela do D+0', q: Number(String(bt || '').replace(',', '.')) || 0, qTxt: bt || '' }
        };
      });
      recsOut[imp.id] = one;
      add[impI] = Object.assign({}, imp, { status: 'encerrada', inicio: sess.inicio || t, inicioDay: sess.inicioDay || d, fim: t, fimDay: d, respReal: byI, marco: 'Registrado na tabela do D+0' });
    }
    const lotes = Object.assign({}, s.lotes);
    lotes[lote.id] = Object.assign({}, lote, { status: 'ativo', formDay: d, previsto: lote.animals.length });
    const def = Object.assign({}, s.def);
    if (iaS && !def[iaS.id]) def[iaS.id] = lote.touros && lote.touros.length ? this.semFromTouro(lote.touros[0], (lote.team || this.defTeam()).ins) : this.defSem((lote.team || this.defTeam()).ins);
    this.setState({
      lotes: lotes, def: def, ack: {}, recs: recsOut,
      sessions: s.sessions.map(x => (x.id === sess.id ? Object.assign({}, x, { status: 'encerrada', fim: x.fim && this.horaOk(x.fim) ? x.fim : t, fimDay: d }) : x)).concat(add),
      screen: 'lote', lid: lote.id, sid: null, retTo: null
    });
    this.flash(lote.nome + ': D+0 concluído com ' + lote.animals.length + ' fêmeas, implante e benzoato registrados. Próximo passo: retirada (simulação).', false);
  }

  confirmAll() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const id = s.cur;
    const t = this.fmt(s.now.min);
    const fic = (s.ficha[sess.id] || {})[id];
    const r = {};
    sess.procs.forEach(p => {
      r[p.id] = { st: (fic && p.id === 'ret') ? 'conf' : 'exec', t: t, prec: 'individual', by: p.by, motivo: '', hist: [], origem: 'aplicativo' };
    });
    this.setState({ recs: this.putRec(sess.id, id, r), now: this.adv(0.5), cur: null, q: '', mode: 'new', draft: {}, motivo: '', undo: this.snap() });
    if (fic) this.flash(id + ': lançado, mas em conflito com a ficha ' + fic.ficha + '. Fica pendente de conciliação.', true);
    else this.flash(id + ': ' + sess.procs.length + ' procedimentos lançados nesta simulação (nada é gravado).', true);
  }

  setDraft(pid, st) {
    const d = Object.assign({}, this.state.draft);
    if (d[pid] === st) delete d[pid]; else d[pid] = st;
    this.setState({ draft: d });
  }

  savePartial() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const id = s.cur;
    const t = this.fmt(s.now.min);
    const old = this.rec(sess.id, id);
    const marked = sess.procs.filter(p => s.draft[p.id]);
    if (!marked.length) { this.flash('Marque ao menos um procedimento. Os sem marcação continuam pendentes.', false); return; }
    const needMot = marked.some(p => s.draft[p.id] !== 'exec');
    if (needMot && !s.motivo) { this.flash('Escolha o motivo da exceção antes de salvar.', false); return; }
    const fic = (s.ficha[sess.id] || {})[id];
    const r = Object.assign({}, old);
    let changed = 0;
    marked.forEach(p => {
      const want = s.draft[p.id];
      const prev = old[p.id];
      const st = (fic && p.id === 'ret' && want === 'exec') ? 'conf' : want;
      const mot = (st === 'exec' || st === 'conf') ? '' : s.motivo;
      if (prev && prev.st === st && (prev.motivo || '') === mot) return;
      const hist = prev ? (prev.hist || []).concat(s.corr ? [{ de: this.stLabel(prev.st) + (prev.motivo ? ' (' + prev.motivo + ')' : ''), motivo: s.corrMotivo, em: t }] : []) : [];
      r[p.id] = { st: st, t: t, prec: 'individual', by: p.by, motivo: mot, hist: hist, origem: 'aplicativo' };
      changed += 1;
    });
    if (!changed) { this.flash('Nada mudou em relação ao registro atual.', false); return; }
    this.setState({ recs: this.putRec(sess.id, id, r), now: this.adv(0.5), cur: null, q: '', mode: 'new', draft: {}, motivo: '', corr: false, corrMotivo: '', undo: this.snap() });
    this.flash(id + (s.corr ? ': correção lançada nesta simulação, com histórico.' : ': lançamento parcial nesta simulação. O que ficou sem marcação continua pendente.'), true);
  }

  confirmIA() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const id = s.cur;
    const ri = this.retInfo(sess.loteId, id);
    const t = this.fmt(s.now.min);
    const sem = s.override || s.def[sess.id] || this.defSem();
    const st = ri.ok ? 'exec' : 'aval';
    const r = { ia: { st: st, t: t, prec: 'individual', by: sem.insem, motivo: ri.ok ? '' : 'Retirada não confirmada', hist: [], origem: 'aplicativo', touro: sem.touro, cod: sem.cod, partida: sem.partida, origemSem: sem.origem, insem: sem.insem, raca: sem.raca || '' } };
    this.setState({ recs: this.putRec(sess.id, id, r), now: this.adv(0.5), cur: null, q: '', override: null, undo: this.snap() });
    this.flash(id + ': IA lançada às ' + t + (ri.ok ? '' : ' · necessita avaliação') + ' (simulação, nada é gravado).', true);
  }

  openTroca(scope) {
    const s = this.state;
    const base = s.override || s.def[s.sid] || this.defSem();
    const bl = this.bulls().find(b => b.nome === base.touro);
    const pIdx = bl ? bl.partidas.findIndex(p => p.p === base.partida && p.o === base.origem) : -1;
    this.setState({ sheet: { kind: 'troca', scope: scope, q: '', bull: bl ? bl.id : null, pIdx: pIdx >= 0 ? pIdx : null, insem: base.insem } });
  }

  applyTroca() {
    const s = this.state;
    const sh = s.sheet;
    const b = this.bulls().find(x => x.id === sh.bull);
    if (!b || sh.pIdx === null || sh.pIdx === undefined) { this.flash('Escolha o touro e a partida.', false); return; }
    const sem = { touro: b.nome, cod: b.cod, raca: b.raca || '', partida: b.partidas[sh.pIdx].p, origem: b.partidas[sh.pIdx].o, insem: sh.insem };
    if (sh.scope === 'default') {
      const def = Object.assign({}, s.def);
      def[s.sid] = sem;
      this.setState({ def: def, sheet: null });
      this.flash('Novo padrão vale só para os próximos lançamentos. Os já lançados não mudam.', false);
      return;
    }
    if (sh.scope === 'one') {
      this.setState({ override: sem, sheet: null });
      this.flash('Sêmen alterado só para ' + s.cur + '. O padrão da sessão continua o mesmo.', false);
      return;
    }
    const prev = this.rec(s.sid, s.cur).ia;
    if (prev.touro === sem.touro && prev.partida === sem.partida && prev.origemSem === sem.origem && prev.insem === sem.insem) { this.flash('Nenhuma alteração em relação ao registro.', false); return; }
    const t = this.fmt(s.now.min);
    const nr = Object.assign({}, prev, { touro: sem.touro, cod: sem.cod, raca: sem.raca || '', partida: sem.partida, origemSem: sem.origem, insem: sem.insem, by: sem.insem, hist: (prev.hist || []).concat([{ de: prev.touro + ' · ' + prev.partida + ' · ' + prev.insem, motivo: s.corrMotivo, em: t }]) });
    this.setState({ recs: this.putRec(s.sid, s.cur, { ia: nr }), sheet: null, corr: false, corrMotivo: '', undo: this.snap() });
    this.flash(s.cur + ': correção lançada nesta simulação, com histórico.', true);
  }

  saveExc() {
    const s = this.state;
    const sh = s.sheet;
    if (!sh.st || !sh.motivo) { this.flash('Escolha o que aconteceu e o motivo.', false); return; }
    const sess = this.sess(s.sid);
    const id = s.cur;
    const t = this.fmt(s.now.min);
    const prev = this.rec(sess.id, id).ia;
    const sem = s.override || s.def[sess.id] || this.defSem();
    const withSem = sh.st !== 'nao';
    const nr = {
      st: sh.st, t: t, prec: 'individual', by: withSem ? sem.insem : '', motivo: sh.motivo, origem: 'aplicativo',
      touro: withSem ? sem.touro : '', cod: withSem ? sem.cod : '', raca: withSem ? (sem.raca || '') : '', partida: withSem ? sem.partida : '', origemSem: withSem ? sem.origem : '', insem: withSem ? sem.insem : '',
      hist: prev ? (prev.hist || []).concat(s.corr ? [{ de: this.stLabel(prev.st), motivo: s.corrMotivo, em: t }] : []) : []
    };
    this.setState({ recs: this.putRec(sess.id, id, { ia: nr }), now: this.adv(0.5), sheet: null, cur: null, q: '', override: null, corr: false, corrMotivo: '', undo: this.snap() });
    this.flash(id + ': ' + this.stLabel(sh.st).toLowerCase() + ' · lançado nesta simulação.', true);
  }

  dgSet(st) {
    const s = this.state;
    const sess = this.sess(s.sid);
    const id = s.cur;
    const t = this.fmt(s.now.min);
    const prev = this.rec(sess.id, id).dg;
    if (prev && !s.corr) return;
    const obs = [].concat(s.dgObs, String(s.dgObsTxt || '').trim() ? [String(s.dgObsTxt).trim()] : []).join(' · ');
    const rec = {
      st: st, t: t, by: sess.resp, obs: prev ? prev.obs : obs, origem: 'aplicativo',
      hist: prev ? (prev.hist || []).concat([{ de: this.stLabel(prev.st), motivo: s.corrMotivo, em: t }]) : []
    };
    this.setState({ recs: this.putRec(sess.id, id, { dg: rec }), now: this.adv(0.5), cur: null, q: '', dgObs: [], dgObsTxt: '', dgObsOpen: false, corr: false, corrMotivo: '', sheet: null, undo: this.snap() });
    this.flash(id + ': ' + this.stLabel(st) + (prev ? ' · correção com histórico' : '') + ' · lançado nesta simulação.', true);
  }

  corrNext() {
    const s = this.state;
    const sh = s.sheet;
    if (!sh.motivo) { this.flash('Escolha o motivo da correção.', false); return; }
    const sess = this.sess(s.sid);
    const r = this.rec(sess.id, s.cur);
    if (sess.tipo === 'Diagnóstico') {
      this.setState({ corr: true, corrMotivo: sh.motivo, sheet: { kind: 'dgres' } });
      return;
    }
    if (sess.tipo === 'Retirada' || sess.tipo === 'Implantação') {
      const draft = {};
      sess.procs.forEach(p => { if (r[p.id]) draft[p.id] = r[p.id].st === 'conf' ? 'exec' : r[p.id].st; });
      const pm = sess.procs.map(p => r[p.id]).find(x => x && x.motivo);
      this.setState({ sheet: null, mode: 'partial', corr: true, corrMotivo: sh.motivo, draft: draft, motivo: pm ? pm.motivo : '' });
      return;
    }
    const ir = r.ia || {};
    if (ir.touro) {
      const bl = this.bulls().find(b => b.nome === ir.touro);
      const pIdx = bl ? bl.partidas.findIndex(p => p.p === ir.partida && p.o === ir.origemSem) : -1;
      this.setState({ corr: true, corrMotivo: sh.motivo, sheet: { kind: 'troca', scope: 'corr', q: '', bull: bl ? bl.id : null, pIdx: pIdx >= 0 ? pIdx : null, insem: ir.insem || 'Insem. Fictício' } });
    } else {
      this.setState({ corr: true, corrMotivo: sh.motivo, sheet: { kind: 'exc', st: '', motivo: '' } });
    }
  }

  saveInicio() {
    const s = this.state;
    const sh = s.sheet;
    if (!sh.motivo || !sh.delta) { this.flash('Ajuste o horário e escolha a justificativa.', false); return; }
    const ss = this.sess(s.sid);
    const nv = this.fmt(this.toMin(ss.inicio) + sh.delta);
    this.setState({ sessions: s.sessions.map(x => (x.id === ss.id ? Object.assign({}, x, { inicio: nv, inicioHist: x.inicioHist.concat([{ de: ss.inicio, para: nv, motivo: sh.motivo }]) }) : x)), sheet: null });
    this.flash('Início corrigido de ' + ss.inicio + ' para ' + nv + ', com justificativa (simulação).', false);
  }

  finish() {
    const s = this.state;
    const sess = this.sess(s.sid);
    const t = sess.fim && this.horaOk(sess.fim) ? sess.fim : this.fmt(s.now.min);
    const sessions = s.sessions.map(x => (x.id === sess.id ? Object.assign({}, x, { status: 'encerrada', fim: t, fimDay: x.fimDay || s.now.day }) : x));
    if (sess.tipo === 'Diagnóstico') {
      const one = Object.assign({}, s.recs[sess.id] || {});
      let n = 0;
      this.participants(sess.id).forEach(a => {
        if (!one[a.id] || !one[a.id].dg) { one[a.id] = { dg: { st: 'naoex', t: t, by: sess.resp, obs: '', hist: [], origem: 'encerramento da sessão' } }; n += 1; }
      });
      const recs = Object.assign({}, s.recs);
      recs[sess.id] = one;
      this.setState({ sessions: sessions, recs: recs, screen: 'resumo', rLote: sess.loteId, cur: null, q: '', now: this.adv(1) });
      this.flash('Diagnóstico encerrado às ' + t + ' (simulação). ' + n + (n === 1 ? ' fêmea ficou' : ' fêmeas ficaram') + ' como não examinada.', false);
      return;
    }
    const back = s.retTo === 'ficha' ? 'ficha' : (s.retTo === 'lote' ? 'lote' : 'hoje');
    const iaF = this.sessOf(sess.loteId, 'Inseminação');
    this.setState({ sessions: sessions, screen: back, sid: back === 'ficha' && iaF ? iaF.id : null, lid: back === 'hoje' ? s.lid : sess.loteId, retTo: back === 'ficha' ? null : s.retTo, cur: null, q: '', now: this.adv(1) });
    this.flash(back === 'ficha' ? 'Ficha finalizada às ' + t + ' (simulação). Veja o próximo passo no topo.' : 'Sessão encerrada às ' + t + ' nesta simulação. Nada foi gravado.', false);
  }

  undo() {
    const u = this.state.undo;
    if (!u) return;
    this.setState({ recs: u.recs, now: u.now, lotes: u.lotes, undo: null });
    this.flash('Último lançamento desfeito.', false);
  }

  rowDetail(sess, a) {
    const r = this.rec(sess.id, a.id);
    if (sess.tipo === 'Diagnóstico') {
      const ia = this.iaInfo(sess.loteId, a.id).rec;
      const base = ia && ia.touro ? ia.touro + ' · ' + ia.partida : '';
      return r.dg && r.dg.obs ? base + ' · ' + r.dg.obs : base;
    }
    if (sess.tipo === 'Inseminação') {
      const ir = r.ia;
      if (!ir) return this.retInfo(sess.loteId, a.id).st;
      return (ir.touro ? ir.touro + ' · ' + ir.partida : '') + (ir.motivo ? (ir.touro ? ' · ' : '') + ir.motivo : '');
    }
    const bad = sess.procs.filter(p => r[p.id] && r[p.id].st !== 'exec').map(p => p.curto + ': ' + this.stLabel(r[p.id].st) + (r[p.id].motivo ? ' (' + r[p.id].motivo + ')' : ''));
    if (bad.length) return bad.join(' · ');
    return a.cat + ' · CC ' + (a.cc || '—');
  }

  prodRows(sess) {
    const recs = this.state.recs[sess.id] || {};
    if (sess.tipo === 'Inseminação') {
      const g = {};
      Object.keys(recs).forEach(id => {
        const ir = recs[id].ia;
        if (ir && ir.touro && (ir.st === 'exec' || ir.st === 'desvio' || ir.st === 'aval')) {
          const key = ir.touro + ' · ' + ir.partida;
          if (!g[key]) g[key] = { n: 0, o: ir.origemSem };
          g[key].n += 1;
        }
      });
      const rows = Object.keys(g).map(k => ({ nome: k, calc: g[k].o + ' · ' + g[k].n + (g[k].n === 1 ? ' inseminação lançada' : ' inseminações lançadas'), total: g[k].n + (g[k].n === 1 ? ' dose' : ' doses') }));
      const gl = (() => { let n = 0; let q = 0; Object.keys(recs).forEach(id => { const ir = recs[id].ia; if (ir && ir.gnrhQ !== undefined && (ir.st === 'exec' || ir.st === 'desvio' || ir.st === 'aval')) { n += 1; q += ir.gnrhQ || 0; } }); return n ? [{ nome: this.gnrhOf(this.state.lotes[sess.loteId]).nome, calc: n + (n === 1 ? ' vaca' : ' vacas') + ' com GnRH registrado', total: this.num(q) + ' ml' }] : []; })();
      return rows.length ? rows.concat(gl) : [{ nome: 'Nenhuma inseminação lançada', calc: 'O consumo aparece conforme cada IA é confirmada.', total: '0 doses' }];
    }
    return sess.procs.map(p => {
      let n = 0;
      let dv = 0;
      let tq = 0;
      let aj = 0;
      Object.keys(recs).forEach(id => {
        const x = recs[id][p.id];
        if (x && (x.st === 'exec' || x.st === 'desvio')) { n += 1; if (x.st === 'desvio') dv += 1; tq += x.qTxt !== undefined ? (x.q || 0) : (p.q || 0); if (x.qTxt !== undefined) aj += 1; }
      });
      if (aj) return { nome: p.nome, calc: n + (n === 1 ? ' confirmado' : ' confirmados') + ' · ' + aj + ' com dose ajustada na ficha', total: this.num(tq) + ' ' + p.un };
      if (!p.q) return { nome: p.nome, calc: 'Dose a registrar na ficha · ' + n + (n === 1 ? ' animal confirmado' : ' animais confirmados'), total: '—' };
      return { nome: p.nome, calc: p.dose + ' por animal × ' + n + (n === 1 ? ' confirmado' : ' confirmados') + (dv ? ' (' + dv + ' com desvio: conferir quantidade real)' : ''), total: this.num(n * p.q) + ' ' + p.un };
    });
  }

  lotSummary(loteId) {
    const s = this.state;
    const lote = s.lotes[loteId];
    const rs = this.sessOf(loteId, 'Retirada');
    const ds = this.sessOf(loteId, 'Diagnóstico');
    const vinc = lote.animals.length;
    let retN = '—';
    let retNote = 'sem sessão de retirada registrada neste protótipo';
    if (rs && s.recs[rs.id]) {
      const c = this.counts(rs.id);
      retN = c.ok;
      retNote = c.exc + ' com exceção · ' + c.conf + ' em conflito · ' + c.pend + ' pendentes';
    }
    const insem = lote.animals.filter(a => this.iaDone(loteId, a.id));
    const dgr = ds ? (s.recs[ds.id] || {}) : {};
    const st = id => (dgr[id] && dgr[id].dg ? dgr[id].dg.st : 'pend');
    let p = 0;
    let v = 0;
    let i = 0;
    let ne = 0;
    insem.forEach(a => { const k = st(a.id); if (k === 'prenhe') p += 1; else if (k === 'vazia') v += 1; else if (k === 'inconc') i += 1; else ne += 1; });
    const exam = p + v + i;
    const bar = n => 'width: ' + (vinc && typeof n === 'number' ? Math.round(n / vinc * 100) : 0) + '%';
    const funnel = [
      { label: 'Vinculadas na formação', n: vinc, note: 'formação em ' + this.fd(lote.formDay), bar: bar(vinc) },
      { label: 'Retirada executada', n: retN, note: retNote, bar: bar(retN) },
      { label: 'Inseminadas', n: insem.length, note: (vinc - insem.length) + ' não inseminadas, com motivo registrado', bar: bar(insem.length) },
      { label: 'Examinadas no diagnóstico', n: exam, note: ne + ' não examinadas', bar: bar(exam) },
      { label: 'Prenhes', n: p, note: 'resultado provisório, a validar pelo veterinário', bar: bar(p) }
    ];
    const groupBy = (keyFn) => {
      const g = {};
      insem.forEach(a => {
        const k = keyFn(a);
        if (!g[k]) g[k] = { ins: 0, exam: 0, p: 0 };
        g[k].ins += 1;
        const r = st(a.id);
        if (r === 'prenhe' || r === 'vazia' || r === 'inconc') g[k].exam += 1;
        if (r === 'prenhe') g[k].p += 1;
      });
      return Object.keys(g).sort().map(k => ({ nome: k, txt: g[k].p + ' prenhes de ' + g[k].exam + ' examinadas (' + this.pct(g[k].p, g[k].exam) + ') · ' + g[k].ins + ' inseminadas' }));
    };
    const touros = groupBy(a => { const r = this.iaInfo(loteId, a.id).rec; return r.touro + (r.raca ? ' · ' + r.raca : '') + (r.partida && r.partida !== '—' ? ' · ' + r.partida : ''); });
    const insems = groupBy(a => 'Inseminador: ' + this.iaInfo(loteId, a.id).rec.insem);
    const catsG = groupBy(a => 'Categoria: ' + a.cat);
    return {
      hasRes: !!(ds && ds.status === 'encerrada' && v > 0),
      resLabel: lote.ressincId && s.lotes[lote.ressincId] ? 'Abrir ' + s.lotes[lote.ressincId].nome + ' (ressincronização)' : 'Criar lote de ressincronização com ' + v + ' vazias',
      resGo: lote.ressincId && s.lotes[lote.ressincId] ? () => this.openLote(lote.ressincId) : () => this.startRessinc(loteId),
      title: 'Resumo · ' + lote.nome,
      sub: this.fazNome(lote.faz) + (ds ? ' · DG ' + this.fd(ds.inicioDay || ds.planDay) : ''),
      parcial: !ds || ds.status !== 'encerrada',
      funnel: funnel,
      res: [
        { label: 'Prenhe', n: p, css: this.pal('prenhe') },
        { label: 'Vazia', n: v, css: this.pal('vazia') },
        { label: 'Inconclusivo · reexame pendente', n: i, css: this.pal('inconc') },
        { label: 'Não examinada', n: ne, css: this.pal('naoex') }
      ],
      taxas: [
        { label: 'Prenhes ÷ examinadas (' + p + ' de ' + exam + ')', val: this.pct(p, exam) },
        { label: 'Prenhes ÷ inseminadas (' + p + ' de ' + insem.length + ')', val: this.pct(p, insem.length) },
        { label: 'Prenhes ÷ vinculadas (' + p + ' de ' + vinc + ')', val: this.pct(p, vinc) }
      ],
      touros: touros.length ? touros : [{ nome: 'Sem inseminações', txt: '' }],
      outros: insems.concat(catsG)
    };
  }

  grp(x) {
    const s = this.state;
    const lote = s.lotes[x.loteId];
    const today = s.now.day;
    if (!lote) return null;
    if (x.status === 'andamento') return 'andamento';
    if (x.status === 'encerrada') return x.fimDay === today ? 'encerrada' : null;
    if (lote.status === 'rascunho' && x.tipo !== 'Formação') return null;
    if (x.planDay === today) return 'hoje';
    if (x.planDay < today) return 'atrasada';
    if (x.planDay <= today + 10) return 'proxima';
    return null;
  }

  cardVM(x, g) {
    const s = this.state;
    const lote = s.lotes[x.loteId];
    const started = g === 'andamento' || g === 'encerrada';
    const parts = this.participants(x.id);
    let bar = 'width: 0%';
    let prog = '';
    let nTxt = (parts.length || x.n) + ' animais';
    if (x.tipo === 'Formação') {
      nTxt = 'previsto ' + lote.previsto;
      bar = 'width: ' + Math.min(100, Math.round(lote.animals.length / lote.previsto * 100)) + '%';
      prog = lote.animals.length + ' de ' + lote.previsto + ' previstos registrados';
    } else if (x.tipo === 'Diagnóstico') {
      nTxt = parts.length + ' inseminadas';
      if (started && parts.length) {
        const c = this.counts(x.id);
        bar = 'width: ' + Math.round(c.exam / c.n * 100) + '%';
        prog = c.exam + ' de ' + c.n + ' examinadas · ' + c.prenhe + ' prenhes · ' + c.vazia + ' vazias · ' + c.inconc + ' inconclusivas · ' + (c.pend + c.naoex) + ' não examinadas';
      }
    } else if (started && parts.length) {
      const c = this.counts(x.id);
      const done = c.n - c.pend;
      bar = 'width: ' + Math.round(done / c.n * 100) + '%';
      prog = done + ' de ' + c.n + ' lançados · ' + c.ok + ' confirmados · ' + c.exc + ' com exceção · ' + c.conf + ' em conflito · ' + c.pend + ' pendentes';
    }
    const atraso = s.now.day - x.planDay;
    const stMap = { andamento: ['Em andamento', 'prog'], hoje: ['Programada', 'pend'], atrasada: [atraso + (atraso === 1 ? ' dia de atraso' : ' dias de atraso'), 'late'], proxima: ['Programada', 'pend'], encerrada: ['Encerrada', 'done'] };
    const st = stMap[g];
    let ctaLabel = { andamento: 'Retomar sessão', hoje: 'Abrir sessão', atrasada: 'Abrir sessão', proxima: 'Ver sessão', encerrada: 'Ver sessão' }[g];
    let go = () => this.setState({ screen: 'abrir', sid: x.id, cur: null, q: '' });
    if (g === 'andamento') {
      if (x.tipo === 'Formação') { ctaLabel = 'Retomar formação'; go = () => this.setState({ screen: 'form', sid: x.id, fq: '', fcat: lote.catSug, fcc: '', fobs: [], fobsTxt: '' }); }
      else go = () => this.setState({ screen: 'exec', sid: x.id, cur: null, q: '', mode: 'new', draft: {}, motivo: '', corr: false, override: null });
    }
    if (g === 'encerrada' && x.tipo === 'Diagnóstico') { ctaLabel = 'Ver resumo do lote'; go = () => this.setState({ screen: 'resumo', sid: x.id, rLote: x.loteId }); }
    const primary = g === 'andamento' || g === 'hoje';
    return {
      title: x.tipo + ' · ' + lote.nome,
      where: this.fazNome(x.faz) + ' · ' + x.curral,
      plan: 'Planejado ' + this.fd(x.planDay) + ' · ' + x.planHora,
      n: nTxt,
      real: x.inicio ? 'Início real ' + x.inicio + (x.fim ? ' · término ' + x.fim : '') : '',
      status: st[0], pill: this.pill(st[1]), started: started, bar: bar, prog: prog,
      border: g === 'atrasada' ? 'border: 2px solid #B3261E' : (g === 'andamento' ? 'border: 2px solid #0B4F57' : 'border: 1px solid #D3DBD5'),
      ctaLabel: ctaLabel,
      cta: primary ? 'background: #0B4F57; color: #FFFFFF; border: none' : 'background: #FFFFFF; color: #0B4F57; border: 2px solid #0B4F57',
      go: go
    };
  }

