      if (ia.rec.st !== 'exec') rows.push({ k: 'Situação da IA', v: this.stLabel(ia.rec.st) + (ia.rec.motivo ? ' · ' + ia.rec.motivo : '') });
    } else {
      rows.push({ k: 'Inseminação', v: 'sem inseminação registrada neste lote' });
    }
    rows.push({ k: 'Formação', v: (a ? a.cat + ' · CC ' + (a.cc || '—') : '—') + ' · ' + this.fd(lote.formDay) });
    if (this.sessOf(loteId, 'Retirada')) rows.push({ k: 'Retirada', v: this.retInfo(loteId, aid).st });
    rows.push({ k: 'Observações', v: a && a.obs ? 'formação: ' + a.obs : 'nenhuma anterior' });
    return rows;
  }

  summ(sid, id) {
    const sess = this.sess(sid);
    const r = this.rec(sid, id);
    if (sess.tipo === 'Diagnóstico') return r.dg ? r.dg.st : 'pend';
    const sts = sess.procs.map(p => (r[p.id] ? r[p.id].st : 'pend'));
    if (sts.indexOf('conf') >= 0) return 'conf';
    if (sts.every(x => x === 'pend')) return 'pend';
    if (sts.every(x => x === 'exec')) return 'ok';
    return 'exc';
  }
  counts(sid) {
    const c = { n: 0, ok: 0, pend: 0, exc: 0, conf: 0, prenhe: 0, vazia: 0, inconc: 0, naoex: 0 };
    this.participants(sid).forEach(a => { c.n += 1; c[this.summ(sid, a.id)] += 1; });
    c.exam = c.prenhe + c.vazia + c.inconc;
    return c;
  }

  stLabel(st) {
    const m = { pend: 'Pendente', exec: 'Executado', desvio: 'Executado com desvio', nao: 'Não realizado', aval: 'Necessita avaliação', conf: 'Em conflito', none: 'Sem marcação', prenhe: 'Prenhe', vazia: 'Vazia', inconc: 'Inconclusivo', naoex: 'Não examinada' };
    return m[st] || st;
  }
  sumLabel(k) {
    const m = { ok: 'Confirmado', pend: 'Pendente', exc: 'Com exceção', conf: 'Em conflito', prenhe: 'Prenhe', vazia: 'Vazia', inconc: 'Inconclusivo', naoex: 'Não examinada' };
    return m[k] || k;
  }
  pal(kind) {
    const m = {
      pend: ['#E4EBE7', '#2F3A37', '#B9C4BE'], none: ['#FFFFFF', '#4A5955', '#B9C4BE'],
      exec: ['#E5F1DC', '#24561A', '#3B7A1F'], ok: ['#E5F1DC', '#24561A', '#3B7A1F'],
      desvio: ['#FFF1CF', '#6B4505', '#B7791F'], exc: ['#FFF1CF', '#6B4505', '#B7791F'],
      nao: ['#FCE8E6', '#8C1D18', '#B3261E'], aval: ['#FFE6CC', '#7A3E00', '#C2610C'],
      conf: ['#E3ECF7', '#1F4E79', '#2F5D8A'], late: ['#FCE8E6', '#8C1D18', '#B3261E'],
      prog: ['#E3EEF0', '#0B4F57', '#0B4F57'], done: ['#E4EBE7', '#2F3A37', '#B9C4BE'],
      prenhe: ['#E5F1DC', '#24561A', '#3B7A1F'], vazia: ['#E4EBE7', '#13201E', '#4A5955'], inconc: ['#FFF1CF', '#6B4505', '#B7791F'], naoex: ['#FFFFFF', '#4A5955', '#9AA8A2']
    };
    const c = m[kind] || m.pend;
    return 'background: ' + c[0] + '; color: ' + c[1] + '; border: 1px solid ' + c[2];
  }
  pill(kind) { return 'align-items: center; min-height: 26px; padding: 2px 10px; border-radius: 13px; font-size: 13px; font-weight: 700; white-space: nowrap; ' + this.pal(kind); }
  sel(on) { return on ? 'background: #0B4F57; color: #FFFFFF; border: 2px solid #0B4F57' : 'background: #FFFFFF; color: #13201E; border: 1px solid #9AA8A2'; }

  flash(msg, undo) {
    if (this._tt) clearTimeout(this._tt);
    this._tt = setTimeout(() => { this._tt = null; this.setState({ toast: null }); }, 5000);
    this.setState({ toast: { msg: msg, undo: !!undo } });
  }

  updSess(id, patch) { this.setState({ sessions: this.state.sessions.map(x => (x.id === id ? Object.assign({}, x, patch) : x)) }); }
  putRec(sid, id, r) {
    const s = this.state;
    const one = Object.assign({}, s.recs[sid] || {});
    one[id] = r;
    const all = Object.assign({}, s.recs);
    all[sid] = one;
    return all;
