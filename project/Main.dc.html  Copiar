  }

  nextSess() {
    const s = this.state;
    const nowAbs = s.now.day * 1440 + s.now.min;
    const c = s.sessions.filter(x => x.status === 'programada' && x.demo && s.lotes[x.loteId] && (s.lotes[x.loteId].status === 'ativo' || x.tipo === 'Formação'))
      .map(x => ({ x: x, abs: x.planDay * 1440 + this.toMin(x.planHora) }))
      .filter(o => o.abs > nowAbs).sort((a, b) => a.abs - b.abs);
    return c.length ? c[0].x : null;
  }
  simNext() {
