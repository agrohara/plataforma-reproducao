    this.flash('Relógio simulado: ' + this.wd(n.planDay) + ', ' + this.fd(n.planDay) + ', ' + this.fmt(this.toMin(n.planHora) - 5) + '.', false);
  }

  simAuto(sidO) {
    const s = this.state;
