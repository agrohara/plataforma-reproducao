<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Portal Reprodutivo · protótipo</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&amp;display=swap">
<style>
body{margin:0}
@media print{.np{display:none !important}.pr-root{height:auto !important;min-height:0 !important;overflow:visible !important;display:block !important;max-width:none !important;border:none !important}}
</style>
</helmet>
<div class="pr-root" style="width: 100%; height: 100vh; min-height: 520px; display: flex; justify-content: center; background: #C9D3CE">
<div class="pr-root" style="width: 100%; height: 100%; position: relative; overflow: hidden; background: #F4F6F3; {{Lay.frameCss}}; color: #13201E; font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; display: flex; flex-direction: column">
<button class="np" onClick="{{H.openSim}}" aria-label="Abrir painel de simulação" style="font-family: inherit; flex: none; min-height: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 8px; padding: 2px 8px; border: none; background: #E4EBE7; color: #2F3A37; font-size: 11px; font-weight: 700; letter-spacing: 0.04em">DADOS FICTÍCIOS · SEM GRAVAÇÃO · {{Lay.modeTxt}} · SIMULAÇÃO ▾</button>
<div class="pr-root" style="flex: 1; min-height: 0; display: flex; {{Lay.shellCss}}">

<sc-if value="{{Lay.tablet}}" hint-placeholder-val="{{false}}">
<nav class="np" aria-label="Navegação principal" style="width: 92px; flex: none; display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 12px 8px; background: #073A40">
<span style="align-self: center; width: 36px; height: 36px; border-radius: 9px; background: #FFFFFF; color: #0B4F57; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; margin-bottom: 10px">PR</span>
<sc-for list="{{Lay.rail}}" as="ri" hint-placeholder-count="4">
<button onClick="{{ri.go}}" style="font-family: inherit; min-height: 56px; border-radius: 12px; border: none; font-size: 13px; font-weight: 700; {{ri.css}}">{{ri.label}}</button>
</sc-for>
</nav>
</sc-if>

<sc-if value="{{Lay.desk}}" hint-placeholder-val="{{false}}">
<nav class="np" aria-label="Menu principal" style="width: 248px; flex: none; display: flex; flex-direction: column; gap: 4px; padding: 16px 12px; background: #073A40; color: #FFFFFF; overflow-y: auto">
<div style="display: flex; align-items: center; gap: 10px; padding: 4px 8px 16px"><span style="width: 32px; height: 32px; border-radius: 8px; background: #FFFFFF; color: #0B4F57; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700">PR</span><span style="font-size: 16px; font-weight: 700">Portal Reprodutivo</span></div>
<sc-for list="{{Lay.menu}}" as="mi" hint-placeholder-count="8">
<button onClick="{{mi.go}}" style="font-family: inherit; min-height: 44px; padding: 0 12px; border-radius: 10px; border: none; text-align: left; font-size: 15px; {{mi.css}}">{{mi.label}}</button>
</sc-for>
<div style="flex: 1"></div>
<div style="padding: 8px; font-size: 13px; line-height: 1.4; color: #D3E6E4">Vet. Fictícia<br>Consultoria Fictícia</div>
</nav>
</sc-if>

<div class="pr-root" style="flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column">

<sc-if value="{{isHoje}}" hint-placeholder-val="{{true}}">
<div style="flex: 1; min-height: 0; display: flex; flex-direction: column">
<div style="flex: none; padding: 12px 16px 14px; background: #0B4F57; color: #FFFFFF; display: flex; flex-direction: column; gap: 10px">
<sc-if value="{{Lay.phone}}" hint-placeholder-val="{{true}}">
<div style="display: flex; align-items: center; justify-content: space-between">
<div style="display: flex; align-items: center; gap: 8px"><span style="width: 28px; height: 28px; border-radius: 7px; background: #FFFFFF; color: #0B4F57; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700">PR</span><span style="font-size: 15px; font-weight: 700">Portal Reprodutivo</span></div>
<span style="font-size: 13px; color: #D3E6E4">Vet. Fictícia</span>
</div>
</sc-if>
<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap">
<h1 style="margin: 0; font-size: 28px; font-weight: 700">Hoje</h1>
<span style="font-size: 14px; color: #D3E6E4">{{todayStr}} · agora {{clockStr}}</span>
</div>
</div>
<div style="flex: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 12px; background: #FFFFFF; border-bottom: 1px solid #D3DBD5">
<sc-for list="{{filterBtns}}" as="f" hint-placeholder-count="3">
<button onClick="{{f.open}}" style="font-family: inherit; flex: none; height: 44px; padding: 0 12px; border-radius: 22px; font-size: 14px; font-weight: 700; white-space: nowrap; {{f.css}}">{{f.label}}</button>
</sc-for>
</div>
<div style="flex: none; padding: 8px 16px 4px; font-size: 13px; color: #4A5955">{{permTxt}}</div>
<div style="flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; {{Lay.pad}}">
<sc-for list="{{sections}}" as="sec" hint-placeholder-count="3">
<div style="display: flex; flex-direction: column; gap: 10px">
<div style="font-size: 13px; font-weight: 700; letter-spacing: 0.05em; color: #2F3A37">{{sec.title}}</div>
<div style="display: grid; gap: 12px; {{Lay.cardCols}}">
<sc-for list="{{sec.items}}" as="it" hint-placeholder-count="1">
<div style="display: flex; flex-direction: column; gap: 8px; padding: 14px; border-radius: 14px; background: #FFFFFF; {{it.border}}">
<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px">
<div style="display: flex; flex-direction: column; gap: 3px; min-width: 0"><span style="font-size: 17px; font-weight: 700">{{it.title}}</span><span style="font-size: 14px; color: #2F3A37">{{it.where}}</span></div>
<span style="display: inline-flex; flex: none; {{it.pill}}">{{it.status}}</span>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; color: #2F3A37"><span>{{it.plan}}</span><span>{{it.n}}</span><span>{{it.real}}</span></div>
<sc-if value="{{it.started}}" hint-placeholder-val="{{false}}">
<div style="display: flex; flex-direction: column; gap: 6px">
<div style="height: 10px; border-radius: 5px; background: #E4EBE7; overflow: hidden"><div style="height: 10px; background: #3B7A1F; {{it.bar}}"></div></div>
<span style="font-size: 13px; line-height: 1.35; color: #2F3A37">{{it.prog}}</span>
</div>
</sc-if>
<div style="flex: 1"></div>
<button onClick="{{it.go}}" style="font-family: inherit; height: 48px; border-radius: 12px; font-size: 16px; font-weight: 700; {{it.cta}}">{{it.ctaLabel}}</button>
</div>
</sc-for>
</div>
</div>
</sc-for>
<sc-if value="{{noSections}}" hint-placeholder-val="{{false}}">
<div style="padding: 24px 12px; text-align: center; color: #4A5955; font-size: 15px; line-height: 1.4">{{emptyTxt}}</div>
<sc-if value="{{emptyCta}}" hint-placeholder-val="{{false}}">
<button onClick="{{H.emptyGo}}" style="font-family: inherit; align-self: center; height: 52px; padding: 0 22px; border-radius: 12px; border: none; background: #0B4F57; color: #FFFFFF; font-size: 16px; font-weight: 700">{{emptyCtaLabel}}</button>
</sc-if>
</sc-if>
</div>
</div>
</sc-if>

<sc-if value="{{isAbrir}}" hint-placeholder-val="{{false}}">
<div style="flex: 1; min-height: 0; display: flex; flex-direction: column">
<div style="flex: none; min-height: 64px; display: flex; align-items: center; gap: 6px; padding: 6px 8px; background: #0B4F57; color: #FFFFFF">
<button aria-label="Voltar" onClick="{{H.back}}" style="font-family: inherit; width: 44px; height: 44px; flex: none; display: flex; align-items: center; justify-content: center; border: none; background: transparent; color: #FFFFFF"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg></button>
<div style="display: flex; flex-direction: column; gap: 2px; min-width: 0">
<span style="font-size: 18px; font-weight: 700">{{A.title}}</span>
<span style="font-size: 13px; color: #D3E6E4">{{A.sub}}</span>
</div>
</div>
<div style="flex: 1; min-height: 0; overflow-y: auto; padding: 14px 16px">
<div style="display: flex; flex-direction: column; gap: 14px; {{Lay.wrap}}">
<sc-if value="{{A.fora}}" hint-placeholder-val="{{false}}">
<div style="padding: 12px 14px; border-radius: 12px; background: #E4EBE7; border: 1px solid #B9C4BE; font-size: 14px; line-height: 1.4; color: #2F3A37">{{A.foraMsg}}</div>
</sc-if>
<div style="font-size: 14px; line-height: 1.4; color: #2F3A37">{{A.marco}}</div>
<div style="display: grid; grid-template-columns: 88px minmax(0, 1fr) minmax(0, 1fr); border: 1px solid #D3DBD5; border-radius: 14px; background: #FFFFFF; overflow: hidden; font-size: 14px">
<div style="padding: 10px; background: #E4EBE7"></div>
<div style="padding: 10px; background: #E4EBE7; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #2F3A37">PLANEJADO (OFICIAL)</div>
<div style="padding: 10px; background: #E4EBE7; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #2F3A37">REAL</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; font-weight: 700">Data e hora</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; font-weight: 700">{{A.planDH}}</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; display: flex; flex-direction: column; gap: 6px">
<span style="{{A.realCss}}">{{A.realDH}}</span>
<sc-if value="{{A.canFix}}" hint-placeholder-val="{{false}}">
<button onClick="{{H.fixStart}}" style="font-family: inherit; align-self: flex-start; min-height: 36px; padding: 0 10px; border-radius: 8px; border: 1px solid #0B4F57; background: #FFFFFF; color: #0B4F57; font-size: 13px; font-weight: 700">Corrigir</button>
</sc-if>
</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; font-weight: 700">Curral</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7">{{A.curralPlan}}</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; display: flex; flex-direction: column; gap: 6px">
<input aria-label="Nome do curral" value="{{A.curralReal}}" onChange="{{A.onCurral}}" placeholder="Nome do curral" autocomplete="off" style="font-family: inherit; width: 100%; min-width: 0; height: 42px; box-sizing: border-box; border: 1px solid #9AA8A2; border-radius: 8px; padding: 0 8px; font-size: 15px; background: #FFFFFF; color: #13201E">
</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; font-weight: 700">Equipe</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; display: flex; flex-direction: column; gap: 4px">
<sc-for list="{{A.equipe}}" as="e" hint-placeholder-count="2">
<span style="line-height: 1.3">{{e.txt}}</span>
</sc-for>
</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; color: #2F3A37; line-height: 1.3">{{A.equipeReal}}</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; font-weight: 700">Procedi­mentos</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; display: flex; flex-direction: column; gap: 4px">
<sc-for list="{{A.procs}}" as="p" hint-placeholder-count="2">
<span style="line-height: 1.3">{{p.txt}}</span>
</sc-for>
</div>
<div style="padding: 10px; border-top: 1px solid #E4EBE7; color: #2F3A37; line-height: 1.3">{{A.procsReal}}</div>
</div>
<sc-if value="{{A.hasHist}}" hint-placeholder-val="{{false}}">
<div style="display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border-radius: 10px; background: #FFFFFF; border: 1px solid #D3DBD5; font-size: 13px; color: #2F3A37">
<sc-for list="{{A.hist}}" as="h" hint-placeholder-count="1"><span>{{h.txt}}</span></sc-for>
</div>
</sc-if>
<sc-if value="{{A.isForm}}" hint-placeholder-val="{{false}}">
<div style="display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 14px; background: #FFFFFF; border: 1px solid #D3DBD5">
<span style="font-size: 13px; font-weight: 700; letter-spacing: 0.05em; color: #2F3A37">CATEGORIA SUGERIDA PARA O LOTE</span>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<sc-for list="{{A.catSugs}}" as="c" hint-placeholder-count="3">
<button onClick="{{c.pick}}" style="font-family: inherit; min-height: 44px; padding: 0 14px; border-radius: 22px; font-size: 15px; font-weight: 700; {{c.css}}">{{c.label}}</button>
</sc-for>
</div>
<span style="font-size: 13px; color: #4A5955">Cada animal confirma a sua categoria ao ser salvo. Previsto: {{A.previsto}} fêmeas.</span>
</div>
</sc-if>
<sc-if value="{{A.isDG}}" hint-placeholder-val="{{false}}">
<div style="padding: 12px 14px; border-radius: 14px; background: #FFFFFF; border: 1px solid #D3DBD5; font-size: 14px; line-height: 1.4">{{A.dgTxt}}</div>
</sc-if>
<sc-if value="{{A.isIA}}" hint-placeholder-val="{{false}}">
<div style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 14px; background: #0B4F57; color: #FFFFFF">
<div style="flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0">
<span style="font-size: 11px; font-weight: 700; letter-spacing: 0.07em; color: #D3E6E4">PADRÃO DA SESSÃO</span>
<span style="font-size: 15px; font-weight: 700">{{A.defTouro}}</span>
<span style="font-size: 13px; color: #E4EBE7">{{A.defPartida}}</span>
<span style="font-size: 13px; color: #E4EBE7">{{A.defInsem}}</span>
</div>
<button onClick="{{H.trocaDefault}}" style="font-family: inherit; flex: none; height: 44px; padding: 0 14px; border-radius: 10px; border: 2px solid #FFFFFF; background: transparent; color: #FFFFFF; font-size: 14px; font-weight: 700">Trocar</button>
</div>
</sc-if>
<div style="padding: 10px 12px; border: 1px dashed #B7791F; border-radius: 10px; background: #FFF1CF; font-size: 13px; line-height: 1.4; color: #6B4505">{{A.pend}}</div>
</div>
</div>
<div style="flex: none; padding: 12px 16px 18px; background: #FFFFFF; border-top: 1px solid #D3DBD5">
<div style="display: flex; flex-direction: column; gap: 8px; {{Lay.wrap}}">
<sc-if value="{{A.notStarted}}" hint-placeholder-val="{{false}}">
<button onClick="{{H.start}}" style="font-family: inherit; height: 58px; border-radius: 12px; border: none; font-size: 18px; font-weight: 700; {{A.startCss}}">{{A.startLabel}}</button>
<span style="font-size: 13px; text-align: center; color: #4A5955">O início real é registrado neste toque, não ao abrir a tela.</span>
</sc-if>
<sc-if value="{{A.andamento}}" hint-placeholder-val="{{false}}">
<button onClick="{{H.resume}}" style="font-family: inherit; height: 58px; border-radius: 12px; border: none; background: #0B4F57; color: #FFFFFF; font-size: 18px; font-weight: 700">{{A.resumeLabel}}</button>
</sc-if>
<sc-if value="{{A.encerrada}}" hint-placeholder-val="{{false}}">
<button onClick="{{A.endGo}}" style="font-family: inherit; height: 52px; border-radius: 12px; border: 2px solid #0B4F57; background: #FFFFFF; color: #0B4F57; font-size: 16px; font-weight: 700">{{A.endLabel}}</button>
</sc-if>
</div>
</div>
</div>
</sc-if>

<sc-if value="{{isForm}}" hint-placeholder-val="{{false}}">
<div style="flex: 1; min-height: 0; display: flex; flex-direction: column">
<div style="flex: none; min-height: 64px; display: flex; align-items: center; gap: 6px; padding: 6px 8px; background: #0B4F57; color: #FFFFFF">
<button aria-label="Voltar" onClick="{{H.back}}" style="font-family: inherit; width: 44px; height: 44px; flex: none; display: flex; align-items: center; justify-content: center; border: none; background: transparent; color: #FFFFFF"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg></button>
<div style="flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0">
<span style="font-size: 18px; font-weight: 700">{{Fm.title}}</span>
<span style="font-size: 13px; color: #D3E6E4">{{Fm.sub}}</span>
</div>
</div>
<div style="flex: 1; min-height: 0; display: flex; {{Lay.fmBody}}">
<div style="display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; background: #FFFFFF; {{Lay.fmSide}}">
<sc-if value="{{Lay.sideCanClose}}" hint-placeholder-val="{{false}}">
<button onClick="{{H.toggleSide}}" style="font-family: inherit; flex: none; align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #9AA8A2; background: #FFFFFF; color: #0B4F57; font-size: 14px; font-weight: 700"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>Recolher painel</button>
</sc-if>
<div style="display: flex; align-items: center; gap: 10px">
<span style="font-size: 15px; font-weight: 700; white-space: nowrap">{{Fm.countTxt}}</span>
<div style="flex: 1; height: 8px; border-radius: 4px; background: #E4EBE7; overflow: hidden"><div style="height: 8px; background: #3B7A1F; {{Fm.bar}}"></div></div>
<span style="display: inline-flex; flex: none; {{Fm.alertPill}}">{{Fm.alertTxt}}</span>
</div>
<div style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 14px; background: #F0F7F7; border: 1px solid #0B4F57">
<span style="font-size: 13px; font-weight: 700; letter-spacing: 0.06em; color: #0B4F57">PADRÃO DO LOTE · VALE PARA TODAS</span>
<span style="font-size: 13px; line-height: 1.35; color: #2F3A37">Escolha uma vez e todas as linhas recebem. Depois troque na tabela só as vacas diferentes.</span>
<label style="font-size: 14px; font-weight: 700; color: #13201E">Categoria</label>
<sc-if value="{{Fm.catT_parida}}" hint-placeholder-val="{{false}}">
<select aria-label="Categoria padrão" value="{{Fm.catPad}}" onChange="{{Fm.onCatPad}}" style="font-family: inherit; width: 100%; height: 52px; box-sizing: border-box; border: 2px solid #0B4F57; border-radius: 12px; padding: 0 10px; font-size: 17px; font-weight: 700; background: #FFFFFF; color: #13201E">
<option value="Multípara">Multípara</option>
<option value="Secundípara">Secundípara</option>
<option value="Primípara">Primípara</option>
<option value="Primípara precoce">Primípara precoce</option>
</select>
</sc-if>
<sc-if value="{{Fm.catT_novilha}}" hint-placeholder-val="{{false}}">
<select aria-label="Categoria padrão" value="{{Fm.catPad}}" onChange="{{Fm.onCatPad}}" style="font-family: inherit; width: 100%; height: 52px; box-sizing: border-box; border: 2px solid #0B4F57; border-radius: 12px; padding: 0 10px; font-size: 17px; font-weight: 700; background: #FFFFFF; color: #13201E">
<option value="Novilha ≥ 24 meses">Novilha ≥ 24 meses</option>
<option value="Novilha precoce">Novilha precoce</option>
<option value="Novilha super precoce">Novilha super precoce</option>
</select>
</sc-if>
<sc-if value="{{Fm.catFixa}}" hint-placeholder-val="{{false}}">
<div style="height: 52px; display: flex; align-items: center; padding: 0 12px; border-radius: 12px; background: #E4EBE7; font-size: 16px; font-weight: 700">{{Fm.catPad}} · lote fechado</div>
</sc-if>
<label style="font-size: 14px; font-weight: 700; color: #13201E">Condição corporal (CC)</label>
<select aria-label="CC padrão" value="{{Fm.ccPad}}" onChange="{{Fm.onCcPad}}" style="font-family: inherit; width: 100%; height: 52px; box-sizing: border-box; border: 2px solid #0B4F57; border-radius: 12px; padding: 0 10px; font-size: 17px; font-weight: 700; background: #FFFFFF; color: #13201E">
<option value="">Sem padrão (digitar vaca por vaca)</option>
<option value="1">1</option>
<option value="1,5">1,5</option>
<option value="2">2</option>
<option value="2,5">2,5</option>
<option value="3">3</option>
<option value="3,5">3,5</option>
<option value="4">4</option>
<option value="4,5">4,5</option>
<option value="5">5</option>
</select>
<label style="font-size: 14px; font-weight: 700; color: #13201E">Raça</label>
<select aria-label="Raça padrão do lote" value="{{Fm.racaPad}}" onChange="{{Fm.onRacaPad}}" style="font-family: inherit; width: 100%; height: 52px; box-sizing: border-box; border: 2px solid #0B4F57; border-radius: 12px; padding: 0 10px; font-size: 17px; font-weight: 700; background: #FFFFFF; color: #13201E">
<option value="">Sem padrão</option>
<option value="Nelore">Nelore</option>
<option value="Angus">Angus</option>
<option value="Cruzada (meio-sangue)">Cruzada (meio-sangue)</option>
<option value="Brangus">Brangus</option>
<option value="Senepol">Senepol</option>
<option value="Brahman">Brahman</option>
<option value="Tabapuã">Tabapuã</option>
<option value="Guzerá">Guzerá</option>
<option value="Gir">Gir</option>
<option value="Girolando">Girolando</option>
<option value="Holandês">Holandês</option>
<option value="Jersey">Jersey</option>
<option value="Outra">Outra</option>
</select>
<span style="font-size: 13px; font-weight: 700; color: #24561A">{{Fm.padNote}}</span>
</div>
<div style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 14px; background: #F0F7F7; border: 1px solid #0B4F57">
