  snap() { const s = this.state; return { recs: s.recs, now: s.now, lotes: s.lotes }; }

  pickAnimal(id) {
    this.setState({ screen: 'exec', cur: id, q: '', mode: 'new', draft: {}, motivo: '', corr: false, corrMotivo: '', override: null, dgObs: [], dgObsTxt: '', dgObsOpen: false });
  }

  setScen(scen) {
    const st = this.seed(scen);
